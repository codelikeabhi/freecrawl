# Freecrawl settings. scripts/fork/setup.sh copies this to .env and fills in
# the placeholders: a new random secret for each, this checkout's paths, and
# which optional services run. Every value can be edited after.

# There is no auth, and the API listens on 127.0.0.1 only
# (docker-compose.override.yaml). Never expose it wider.
USE_DB_AUTHENTICATION=false
FORK_API_PORT=3002

# Optional services that run as containers (stealth, ocr, ollama).
COMPOSE_PROFILES=@PROFILES@

POSTGRES_USER=postgres
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_DB=postgres
SEARXNG_ENDPOINT=http://searxng:8080
SEARXNG_SECRET=@RANDOM@
PARSE_UPLOAD_REF_SECRET=@RANDOM@
SELF_HOSTED_WEBHOOK_HMAC_SECRET=@RANDOM@
AGENT_INTEROP_SECRET=@RANDOM@

# Local model (json, summary, query, agent). The ollama container, or the
# Ollama app on a Mac: http://host.docker.internal:11434/api
OLLAMA_BASE_URL=@OLLAMA_BASE_URL@
MODEL_NAME=@MODEL_NAME@
MODEL_CONTEXT_TOKENS=32768

# Screenshots and PDFs land here; metadata.localFiles points at this folder.
FORK_FILES_HOST_DIR=@FILES_DIR@

# Stealth engine: the stealth container, or the macOS host agent
# (scripts/fork/stealth.sh): http://host.docker.internal:3003/scrape
FORK_STEALTH_URL=@STEALTH_URL@

# OCR for scanned PDFs and images: the ocr container, or the macOS host agent
# (scripts/fork/ocr.sh): http://host.docker.internal:3020
FIRE_PDF_ENABLE=@OCR_ON@
FIRE_PDF_BASE_URL=@OCR_URL@
FIRE_PDF_PERCENT=100
IMAGE_OCR_ENABLED=@OCR_ON@
PDF_RUST_EXTRACT_ENABLE=true
PARSE_PDF_ALWAYS_FIRE_PDF=false

# Our containers behind Firecrawl's service contracts.
RESEARCH_PROXY_URL=http://indexes:8080
SEARCH_PLATFORM_URL=http://indexes:8080
AVGRAB_SERVICE_URL=http://media:8080
FIRE_PRIVACY_URL=http://privacy:8080
PRODUCT_EXTRACTION_SERVICE_URL=http://structured:8080
MENU_EXTRACTION_SERVICE_URL=http://structured:8080

# Local state: scrape index and monitors in nuq-postgres, documents in fake-gcs.
FORK_LOCAL_STATE=true
INDEX_DATABASE_URL=postgresql://postgres:@POSTGRES_PASSWORD@@nuq-postgres:5432/postgres
DATABASE_URL=postgresql://postgres:@POSTGRES_PASSWORD@@nuq-postgres:5432/postgres
GCS_BUCKET_NAME=fc-jobs
GCS_INDEX_BUCKET_NAME=fc-index
FORK_GCS_ENDPOINT=http://fake-gcs:4443
